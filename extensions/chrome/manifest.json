{
  "manifest_version": 3,
  "name": "Grain: who made this image?",
  "short_name": "Grain",
  "version": "0.1.0",
  "description": "Right-click any image to find out who made it, from the image itself, even after screenshots and re-uploads.",
  "homepage_url": "https://grain-on-monad.vercel.app",
  "permissions": ["contextMenus"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Check an image with Grain" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
